# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Neon Postgres connection string (Vercel → Storage → Create → Neon, or neon.tech).
# The "registrations" table is created automatically on first use.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend API key (resend.com → API Keys). Without it, registrations still save but no email is sent.
RESEND_API_KEY=re_xxxxxxxx

# Who receives the "new registration" email (comma-separate for several addresses).
NOTIFY_EMAIL=info@himedprepas.cm

# Sender. Until himedprepas.cm is verified in Resend, keep onboarding@resend.dev —
# note that it can only deliver to the email address you signed up to Resend with.
NOTIFY_FROM=Hi-Med Prepas <onboarding@resend.dev>
# After verifying the domain in Resend, switch to e.g.:
# NOTIFY_FROM=Hi-Med Prepas <noreply@himedprepas.cm>

# Public site URL, used for the "Open admin dashboard" button in the email.
SITE_URL=https://himedprepas.cm

# Admin dashboard login at /admin
ADMIN_PASSWORD=choose-a-long-password
# Random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
